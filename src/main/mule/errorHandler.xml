	<error-handler name="errorHandlerError_Handler" doc:id="e8bd6b6e-9dec-4efe-8d41-95919c17cec7" >
		<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="91bd18ae-37bc-42c9-89ad-97d7486334f4" >
			<ee:transform doc:name="Transform Message" doc:id="8b8a57b2-8f59-4530-8771-fb01fa15c145" >
				<ee:message >
				</ee:message>
				<ee:variables >
					<ee:set-variable variableName="errormsg" ><![CDATA[{
	"ErrorType": (error.errorType.namespace) ++ ":" ++ (error.errorType.identifier),
	"ErrorDescription": if ( isEmpty(error.errorMessage.payload) ) (error.description) else (error.errorMessage.payload),
    "Error Flow Name": (error.failingComponent splitBy"/")[0],
    "Timestamp":now()
}]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
			<!-- [STUDIO:"Transform Message"]<ee:transform doc:name="Transform Message" doc:id="7a75709a-a2a9-4d25-88df-32ebe5fd6a6c" >
				<ee:message >
					<ee:set-payload ><![CDATA[%dw 2.0
output application/json
&#45;&#45;-
{
	
	
}&#93;&#93;></ee:set-payload>
				</ee:message>
			</ee:transform> [STUDIO] -->
			<flow-ref doc:name="Flow Reference" doc:id="2631cdb2-e692-4276-be7d-787539b9d335" name="send_email_sub_flow"/>
