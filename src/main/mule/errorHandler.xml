		<email:send doc:name="Send" doc:id="d3e38c26-960e-42bf-b349-ed22141219b1" config-ref="Email_SMTP" fromAddress="dharanipatteboyina@gmail.com" subject='#["Error in Sf Upsertion"]'>
			<email:to-addresses >
				<email:to-address value="dharanipatteboyina@gmail.com" />
			</email:to-addresses>
			<email:bcc-addresses />
			<email:body contentType="text/plain" encoding="UTF-8">
				<email:content ><![CDATA[#["Hi Team" ++ write(vars."errormsg", "application/json") ++ "\n thank you"]]]></email:content>
			</email:body>
		</email:send>
	</sub-flow>
</mule>
